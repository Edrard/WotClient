{
    "name": "edrard/wotclient",
    "description": "Typed World of Tanks GET client with N/K URL batching and raw HTTP results for PHP 8.5",
    "type": "library",
    "license": "MIT",
    "authors": [{ "name": "Edrard" }],
    "homepage": "https://github.com/Edrard/WotClient",
    "support": {
        "source": "https://github.com/Edrard/WotClient",
        "issues": "https://github.com/Edrard/WotClient/issues"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/Edrard/WgApi.git" },
        { "type": "vcs", "url": "https://github.com/Edrard/WgDataGetter.git" }
    ],
    "require": {
        "php": "^8.5",
        "edrard/wgapi": "^3.0",
        "edrard/wggetter": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": { "psr-4": { "edrard\\WotClient\\": "src/" } },
    "autoload-dev": { "psr-4": { "edrard\\Tests\\WotClient\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": { "sort-packages": true },
    "extra": { "branch-alias": { "dev-main": "3.0.x-dev" } }
}
